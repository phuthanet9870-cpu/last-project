# Copy to .env and fill in. Never commit real secrets.
NODE_ENV=development
PORT=2567
DATABASE_URL=postgres://hb:hb_dev_pw@localhost:5432/hearthbound
REDIS_URL=redis://localhost:6379
# Required in production (random 32+ bytes). Dev uses an ephemeral random secret if unset.
JWT_SECRET=
# Optional: bootstrap an admin account on first start
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Dev-only GM/test commands for admin accounts (ignored when NODE_ENV=production)
DEV_COMMANDS=0
WORLD_ID=w1
WORLD_BOSS_INTERVAL_MS=600000
CORS_ORIGIN=*
REGISTER_LIMIT_PER_HOUR=10
APPEAL_LIMIT_PER_HOUR=5
MARRIAGE_MIN_FRIEND_MS=180000
