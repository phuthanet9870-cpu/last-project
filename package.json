{
  "name": "hearthbound-online",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint packages apps scripts tests",
    "test": "vitest run",
    "build:client": "node scripts/build-client.mjs",
    "build": "pnpm typecheck && pnpm build:client",
    "dev": "node scripts/build-client.mjs --serve",
    "db:migrate": "tsx apps/game-server/src/migrate.ts",
    "db:seed": "tsx apps/game-server/src/seed.ts",
    "server": "tsx apps/game-server/src/main.ts",
    "worker": "tsx apps/worker/src/main.ts",
    "game:start": "node scripts/game-start.mjs",
    "test:e2e": "node tests/e2e/artifact.e2e.mjs",
    "test:multiplayer": "tsx tests/multiplayer/two-clients.test.ts",
    "package": "node scripts/package-deliverables.mjs"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "@types/pg": "8.11.10",
    "@types/ws": "8.5.13",
    "esbuild": "0.24.0",
    "eslint": "9.15.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "bullmq": "5.30.0",
    "fastify": "5.1.0",
    "ioredis": "5.4.1",
    "pg": "8.13.1",
    "ws": "8.18.0",
    "zod": "3.23.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@node-rs/argon2",
      "msgpackr-extract"
    ]
  }
}